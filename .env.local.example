# LOLE Finans — ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayın ve kendi Supabase değerlerinizi girin.
# Vercel'de ise: Project Settings -> Environment Variables bölümüne aynı iki değeri ekleyin.

# Supabase Project URL — sonunda "/rest/v1/" OLMADAN
NEXT_PUBLIC_SUPABASE_URL=https://ajskxcboewophuyxtswy.supabase.co

# Supabase "anon public" / "publishable" anahtarı (gizli değildir, tarayıcıya gider)
# service_role anahtarını ASLA buraya yazmayın.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
